{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vibi",
  "version": "1.0.0",
  "identifier": "local.morgana.companion",
  "build": {
    "beforeDevCommand": "npm run dev:companion -- --host 127.0.0.1 --port 1420",
    "devUrl": "http://localhost:1420/companion.html",
    "beforeBuildCommand": "npm run build:companion",
    "frontendDist": "../dist-companion"
  },
  "app": {
    "windows": [
      {
        "label": "principal",
        "title": "Vibi",
        "url": "index.html",
        "width": 1100,
        "height": 780,
        "minWidth": 420,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": true,
        "focus": true,
        "center": true,
        "backgroundColor": "#0b0810"
      },
      {
        "label": "companion",
        "title": "Vibi",
        "url": "companion.html",
        "width": 320,
        "height": 360,
        "minWidth": 320,
        "minHeight": 360,
        "maxWidth": 320,
        "maxHeight": 360,
        "resizable": false,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true,
        "focus": false
      },
      {
        "label": "proceso",
        "title": "Qué está haciendo Vibi",
        "url": "companion.html",
        "width": 560,
        "height": 700,
        "minWidth": 360,
        "minHeight": 400,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": false,
        "focus": false,
        "center": true,
        "backgroundColor": "#0b0810"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: http://127.0.0.1:8000 http://localhost:8000; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' http://127.0.0.1:8000 http://localhost:8000 ws://127.0.0.1:8000 ws://localhost:8000; media-src 'self' blob:; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": [
      "nsis"
    ],
    "resources": {
      "wake/dist/vibi-wake.exe": "wake/vibi-wake.exe",
      "wake/models/vosk-model-small-es-0.42/": "wake/models/vosk-model-small-es-0.42/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
