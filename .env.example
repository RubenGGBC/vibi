# Copia este archivo a .env y rellena tus claves

# Vía rápida (chat, router, resúmenes) — console.groq.com
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
# Búsqueda web automática en preguntas que necesiten información actual
GROQ_WEB_SEARCH_ENABLED=true
# Sistema Compound de Groq; compound-mini hace 1 búsqueda y gasta menos
# tokens (evita el rate limit de TPM en cuentas on_demand). Usa groq/compound
# si necesitas razonamiento con varias búsquedas encadenadas.
GROQ_SEARCH_MODEL=groq/compound-mini
# Presupuestos aproximados para tareas vivas e historial reciente
GROQ_TASK_CONTEXT_TOKENS=200
GROQ_RECENT_CONTEXT_TOKENS=4000
GROQ_SPEECH_MODEL=whisper-large-v3-turbo
# Límite por clip de voz recibido desde /cara (5 MB por defecto)
VOICE_MAX_AUDIO_BYTES=5000000

# Síntesis de voz (edge-tts) — voces neuronales de Microsoft, sin key ni coste.
# Ponlo en false para volver a la voz del navegador (speechSynthesis), que
# además es el fallback automático si edge-tts falla.
TTS_ENABLED=true
# Otras opciones: es-ES-XimenaNeural, es-ES-AlvaroNeural, es-MX-DaliaNeural
TTS_VOICE=es-ES-ElviraNeural
# Debe coincidir con MAX_CHUNK_CHARS en frontend/src/lib/voice.ts
TTS_MAX_CHARS=600

# Vía agéntica (tareas de código)
# auto: API key si está definida; si no, login de Claude Code Pro/Max
# api: exige ANTHROPIC_API_KEY
# subscription: usa el login persistido e ignora ANTHROPIC_API_KEY
CLAUDE_AUTH_MODE=auto
ANTHROPIC_API_KEY=

# Motor de chat Antigravity (Gemini). Se elige por usuario desde Ajustes; esto
# solo configura el proceso. No lleva API key: se autentica con el login de la
# CLI, que se hace una vez dentro del contenedor y persiste en su volumen.
# Vacío = el `agy` que esté en el PATH (la imagen ya lo instala).
AGY_BINARY=
# Vacío = el modelo elegido en la propia CLI. Flash es lo que hace que este
# motor tenga sentido frente a Haiku; medir con otro lleva a conclusiones falsas.
ANTIGRAVITY_MODEL=
# Abrir `agy` cuesta ~13 s, así que el proceso se reutiliza entre turnos en vez
# de abrirse por mensaje, y se precalienta al arrancar el servidor.
# Cuánto razona antes de contestar (low|medium|high). Es otra palanca distinta
# del sufijo del modelo: `gemini-3.6-flash-low` ya trae su propio nivel, así que
# se combinan. Vacío = lo que traiga la CLI por defecto.
ANTIGRAVITY_EFFORT=high
# Levantar `agy` cuesta 13-42 s, así que el proceso se conserva una hora sin
# usarse. No lo compares con las sesiones de Claude, que abren en un segundo.
ANTIGRAVITY_IDLE_SECONDS=3600
ANTIGRAVITY_MAX_SESSIONS=4
ANTIGRAVITY_WARM_UP=true

# Navegador visible (MCP de Playwright). El servidor no corre aquí sino en tu
# ordenador, lanzado por el agente de nodo: uno abierto dentro del contenedor
# no lo vería nadie.
PLAYWRIGHT_MCP_ENABLED=true
PLAYWRIGHT_MCP_PORT=8931
# Cómo ve el contenedor la máquina donde está el navegador. Con Docker Desktop
# es el anfitrión; si el nodo fuera otra máquina, su nombre en la tailnet.
PLAYWRIGHT_MCP_HOST=host.docker.internal
# Playwright sirve el mismo MCP en /sse y en /mcp.
PLAYWRIGHT_MCP_PATH=/mcp
# `chrome` usa el Chrome instalado; `chromium`, el que se baja Playwright.
# Solo se usa en modo `perfil`.
PLAYWRIGHT_MCP_BROWSER=chrome
# Vacío = el único dispositivo que tengas conectado.
PLAYWRIGHT_MCP_DEVICE=
# De quién es el navegador. `cdp` = el tuyo: se engancha al que ya tienes
# abierto, con tu perfil y tus sesiones, y abre pestañas al lado de las tuyas.
# `perfil` = uno aparte de Morgana, sin ninguna sesión iniciada.
PLAYWRIGHT_MCP_MODE=cdp
# El puerto de depuración del navegador en tu máquina. No es el del servidor
# MCP (PLAYWRIGHT_MCP_PORT): son dos cosas distintas.
PLAYWRIGHT_MCP_CDP_PORT=9333
# Ruta del navegador al que engancharse. Tiene que ser Chromium por dentro, y
# va explícita porque tu navegador por defecto puede ser Firefox, que no vale.
# Windows/Opera GX: %LOCALAPPDATA%\Programs\Opera GX\opera.exe
PLAYWRIGHT_MCP_BROWSER_PATH=
# En qué interfaz escucha el servidor. Vacío = solo localhost, que basta porque
# Docker Desktop hace de intermediario y así el puerto no se ve desde la red.
# Solo hay que ponerlo si el nodo es otra máquina, y entonces queda expuesto:
# ese puerto no pide credenciales.
PLAYWRIGHT_MCP_BIND=

# El ordenador entero. El agente de nodo sirve el disco y el intérprete de
# comandos de tu máquina por MCP; sin esto Morgana solo ve la carpeta del
# workspace, que es lo único que llega dentro del contenedor.
SYSTEM_MCP_ENABLED=true
SYSTEM_MCP_PORT=8932
# Cómo ve el contenedor la máquina cuyo disco se sirve. Con Docker Desktop es
# el anfitrión; si el nodo fuera otro equipo, su nombre en la tailnet.
SYSTEM_MCP_HOST=host.docker.internal
# En qué interfaz escucha. Vacío = solo localhost, que basta con el contenedor
# en ese mismo equipo. Al abrirlo, lo único que queda delante del disco es el
# secreto que el agente pone en la ruta del servidor.
SYSTEM_MCP_BIND=
# Vacío = el único dispositivo que tengas conectado.
SYSTEM_MCP_DEVICE=

# Qué carpetas quedan fuera del alcance de las herramientas de archivos, además
# de las que el agente ya excluye (.ssh, .aws, .gemini, los .env, los *.pem).
# Se declara en la máquina del agente, no aquí. Separadas por ; en Windows.
# MORGANA_FS_EXCLUIR=C:\Users\rebel\Privado;*.kdbx

# MCP de terceros para `agy`. Sin credencial no se declaran, y lo que no se
# declara se borra de su configuración: un servidor al que no se puede entrar
# le cuesta el arranque entero descubrirlo.
#
# Búsqueda web (https://exa.ai). Corre aquí dentro con npx.
EXA_API_KEY=
# MCP oficiales de Google Workspace. Necesitan un proyecto de Google Cloud con
# la API de cada producto **y su MCP API** habilitadas, y un cliente OAuth de
# aplicación de escritorio con el redirect https://antigravity.google/oauth-callback.
# El consentimiento se da una vez a mano; ver el README.
GOOGLE_MCP_CLIENT_ID=
GOOGLE_MCP_CLIENT_SECRET=
# Cuáles quieres. Quitar un nombre de aquí apaga ese servidor sin tocar las
# credenciales: gmail es el que más texto escrito por desconocidos deja entrar.
GOOGLE_MCP_SERVERS=calendar,gmail,drive

# Bot de Telegram — habla con @BotFather para crear uno
TELEGRAM_BOT_TOKEN=123456:ABC...
# Tu chat_id (opcional en fase 1; 0 = acepta al primero que haga /start)
TELEGRAM_OWNER_CHAT_ID=0

# Autenticación de la PWA. Genera un secreto largo y aleatorio.
JWT_SECRET=cambia-esto-por-un-secreto-largo
JWT_EXPIRATION_DAYS=30
# Secreto estable para cifrar las API keys personales. Si queda vacío se usa
# JWT_SECRET; definirlo evita perder las claves si se rota la firma de sesión.
CREDENTIAL_ENCRYPTION_KEY=

# URL pública desde la que se abre la PWA (se añade a Telegram)
PWA_BASE_URL=http://localhost:8000

# Dirección donde Docker publica Morgana. Déjala en loopback con Tailscale Serve.
MORGANA_BIND_ADDRESS=127.0.0.1

# Directorio raíz de workspaces (los proyectos sobre los que trabaja el agente)
WORKSPACE_ROOT=./workspace
# Carpeta del host que Docker monta en /srv/morgana/workspace
WORKSPACE_HOST_PATH=./workspace

# Ubicación histórica de blobs pendientes de migrar. Las subidas nuevas viven
# en WORKSPACE_ROOT/<user_id>/Archivos subidos con su nombre y extensión.
FILE_STORAGE_ROOT=./data/files
FILE_MAX_BYTES=100000000
FILE_USER_QUOTA_BYTES=2000000000
FILE_SCAN_LIMIT=10000
FILE_SEARCH_LIMIT=100

# Tiempo máximo de un clonado Git, en segundos
GIT_CLONE_TIMEOUT_SECONDS=300

# Nodos ejecutores (agente de agent/ instalado en tus máquinas).
# Una orden dirigida a un equipo apagado espera este tiempo y después caduca.
NODE_ORDER_TTL_SECONDS=21600
# Lo que espera una conversación por la respuesta de un nodo encendido.
NODE_RESULT_TIMEOUT_SECONDS=45

# Ruta del build de React que sirve FastAPI
FRONTEND_DIST=./frontend/dist
